{
  "name": "marxsphere",
  "version": "1.3.0",
  "description": "MarxSphere — AI 驱动的马克思主义理论研究科研中枢（推理/检索/知识图谱/Agent/桌面端）",
  "type": "module",
  "main": "electron/dist/main.cjs",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "start": "node dist/src/index.js",
    "start:api": "tsx src/index.ts",
    "start:api:web": "concurrently -k -n api,web -c blue,green \"tsx src/index.ts\" \"vite --host 0.0.0.0\"",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:api && npm run build:web && npm run build:socialsci-vue",
    "build:api": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "dev:desktop": "npm run build:electron && node scripts/dev-desktop.mjs",
    "build:electron": "node electron/build.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:setup": "npm run db:migrate && npm run seed",
    "seed": "tsx src/db/seed.ts",
    "mcp": "SAG_LOG_STDERR=true tsx src/mcp/server.ts",
    "demo:ingest": "tsx scripts/demo-ingest.ts",
    "demo:search": "tsx scripts/demo-search.ts",
    "test": "vitest run",
    "docs:sync": "tsx scripts/doc-sync.ts",
    "docs:check": "tsx scripts/doc-sync.ts --check",
    "sync:open": "node scripts/sync-open.mjs",
    "release": "node scripts/release.mjs",
    "quickstart": "node scripts/quickstart.mjs",
    "deploy": "node scripts/deploy.mjs",
    "dev:socialsci-vue": "vite --config web/socialsci-vue/vite.config.ts",
    "build:socialsci-vue": "vue-tsc -p web/socialsci-vue/tsconfig.json --noEmit && vite build --config web/socialsci-vue/vite.config.ts",
    "typecheck:socialsci-vue": "vue-tsc -p web/socialsci-vue/tsconfig.json --noEmit"
  },
