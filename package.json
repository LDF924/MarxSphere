{
  "name": "marxsphere",
  "version": "1.1.0",
  "description": "MarxSphere 马研星环 — AI 驱动的马克思主义理论研究科研中枢（推理/检索/知识图谱/Agent/桌面端）",
  "type": "module",
  "main": "electron/dist/main.cjs",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "start": "node dist/src/index.js",
    "start:api": "tsx src/index.ts",
    "start:api:web": "concurrently -k -n api,web -c blue,green \"tsx src/index.ts\" \"vite --host 0.0.0.0\"",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "dev:desktop": "npm run build:electron && node scripts/dev-desktop.mjs",
    "build:electron": "node electron/build.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:setup": "npm run db:migrate && npm run seed",
    "seed": "tsx src/db/seed.ts",
    "mcp": "SAG_LOG_STDERR=true tsx src/mcp/server.ts",
    "demo:ingest": "tsx scripts/demo-ingest.ts",
    "demo:search": "tsx scripts/demo-search.ts",
    "test": "vitest run",
    "release": "node scripts/release.mjs",
    "quickstart": "node scripts/quickstart.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@embedpdf/plugin-ai-manager": "^0.0.1",
    "@embedpdf/plugin-annotation": "^2.15.0",
    "@embedpdf/plugin-document-manager": "^2.15.0",
    "@embedpdf/plugin-render": "^2.15.0",
    "@embedpdf/plugin-scroll": "^2.15.0",
    "@embedpdf/plugin-selection": "^2.15.0",
    "@fastify/static": "^10.1.3",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@xyflow/react": "^12.11.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "gpt-tokenizer": "^3.4.0",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.16.47",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.16.1",
    "neo4j-driver": "^6.2.0",
    "p-limit": "^7.3.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^9.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
