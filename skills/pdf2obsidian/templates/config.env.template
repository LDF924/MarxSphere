# ============================================================
# pdf2obsidian 用户配置
# 复制此文件为 config.env（或直接修改）并填写你的参数
# ============================================================

# --- LLM 模式 ---
# local = 本地模型（Ollama / llama.cpp），不消耗 API token
# api   = 云端 API（DeepSeek 等 OpenAI 兼容接口）
LLM_MODE=api

# --- 本地模型设置（LLM_MODE=local 时生效）---
LOCAL_PROVIDER=ollama
LOCAL_MODEL=qwen3:4b

# --- API 模式设置（LLM_MODE=api 时生效）---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=deepseek-chat

# --- MinerU Cloud API ---
MINERU_TOKEN=

# --- 翻译设置 ---
# 本地模式下建议跳过翻译（中文文献无需翻译）
TRANSLATION_TARGET=zh
TRANSLATION_TEMPERATURE=0.3

# --- AI 内容生成设置 ---
GENERATION_TEMPERATURE=0.5

# --- 路径 ---
INPUT_DIR=C:/课题文献库（CSSCI、北大核心、CSCD、AMI、WJCI）/学术期刊/工商资本(2012—2026年6月)
OUTPUT_DIR=C:/课题文献库（CSSCI、北大核心、CSCD、AMI、WJCI）/文献markdown格式

# --- 性能设置 ---
MAX_DAILY_PAGES=900
REQUEST_DELAY_FLASH=15
REQUEST_DELAY_PRECISION=5
MAX_RETRIES=3
